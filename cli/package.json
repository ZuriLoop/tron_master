{
  "name": "@tron-paymaster/cli",
  "version": "0.1.0",
  "description": "Command-line tool and reference relayer for TronPaymaster.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tron-paymaster": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/nile.e2e.test.ts",
    "test:nile": "vitest run test/nile.e2e.test.ts"
  },
  "dependencies": {
    "@tron-paymaster/sdk": "workspace:*",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZuriLoop/tron-paymaster.git",
    "directory": "cli"
  },
  "peerDependencies": {
    "@turnkey/sdk-server": ">=8"
  },
  "peerDependenciesMeta": {
    "@turnkey/sdk-server": {
      "optional": true
    }
  }
}
